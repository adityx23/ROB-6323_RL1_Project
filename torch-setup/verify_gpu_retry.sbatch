#!/usr/bin/env bash
#SBATCH --job-name=rlft-verify-gpu-retry
#SBATCH --account=torch_pr_50_general
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gres=gpu:1
#SBATCH --time=01:50:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --error=logs/%x-%j.err

: "${PROJ:?submit with ./submit.sh (or source config.sh first)}"
set -euo pipefail
cd "$SLURM_SUBMIT_DIR"
printf 'job_id=%s\njob_name=%s\naccount=%s\nhost=%s\nnodes=%s\nstart=%s\nworking_directory=%s\n' \
  "$SLURM_JOB_ID" "$SLURM_JOB_NAME" "${SLURM_JOB_ACCOUNT:-unknown}" "$(hostname)" \
  "$SLURM_JOB_NODELIST" "$(date --iso-8601=seconds)" "$PWD"
module load anaconda3/2025.06
module list
git rev-parse HEAD
git -C ../lair-openpi rev-parse HEAD
sha256sum uv.lock
myquota
unset JAX_PLATFORMS
export WANDB_MODE=disabled PYTHONUNBUFFERED=1 HYDRA_FULL_ERROR=1
# data generated by an earlier verify_gpu.sbatch run (its stage generate-data passed); override with RLFT_REUSE_DATA
export RLFT_REUSE_DATA=${RLFT_REUSE_DATA:-$RLFT_ROOT/runs/verification/gpu-21532910/data}
printf '%s\n' 'inputs=generated oracle data reused from job 21532910; seed=0; no dataset/model downloads' \
  'output=$RLFT_ROOT/runs/verification/gpu-JOBID' \
  'command=bash $PROJ/torch-setup/run.sh python $PROJ/torch-setup/verify_gpu_retry.py'
bash $PROJ/torch-setup/run.sh python $PROJ/torch-setup/verify_gpu_retry.py
printf 'end=%s\n' "$(date --iso-8601=seconds)"
